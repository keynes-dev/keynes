---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Footer } from "../components/Footer";
import { Nav } from "../components/Nav";
import { ClosingCta } from "../components/pages/home/ClosingCta";
import { Deployments } from "../components/pages/home/Deployments";
import { Frontier } from "../components/pages/home/Frontier";
import { Hero } from "../components/pages/home/Hero";
import { HeroDiagram } from "../components/pages/home/HeroDiagram";
import { HowItWorks } from "../components/pages/home/HowItWorks";
import { Thesis } from "../components/pages/home/Thesis";
---

<BaseLayout
  title="Keynes — Runtime economics for agents"
  description="Give your agents observability into your business with programmable resource controls for tokens, tools, time, and more."
>
  <Nav />
  <main>
    <Hero />
    <HeroDiagram client:load />
    <Thesis />
    <HowItWorks client:load />
    <Frontier client:load />
    <Deployments />
    <ClosingCta />
  </main>
  <Footer />
</BaseLayout>

<!--
  Defines the `<conveyor-belt>` tag `Hero` uses. It is registered here rather
  than by the section itself because that section is rendered to HTML and never
  hydrated, so an import inside it would run at build time and never reach the
  browser. A page that wants the drawing has to say so; move this to
  `BaseLayout` if the tag is ever wanted on more than one.
-->
<script>
  import "@/lib/conveyor/element.js";
</script>
