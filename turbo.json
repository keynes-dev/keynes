{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "cache": false,
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@keynes/policy#typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  },
  "globalDependencies": [
    "tsconfig*.json",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "packages/{database,sdk,node-sqlite,postgres,testkit}/{src,scripts}/**",
    "packages/{database,sdk,node-sqlite,postgres,testkit}/*.json",
    "packages/database/{generated,postgres,contract-tests,fixtures}/**"
  ],
  "globalEnv": ["NODE_OPTIONS"]
}
