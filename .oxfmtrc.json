{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "ignorePatterns": [
    "node_modules/**",
    ".turbo/**",
    "coverage/**",
    "reports/**",
    "package-tests/**/fixtures/**",
    "system-tests/**/fixtures/**",
    "artifacts/package-tests/**",
    "artifacts/system-tests/**"
  ]
}
