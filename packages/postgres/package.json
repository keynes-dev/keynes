{
  "name": "@keynes/postgres",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "generated",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/installation/index.d.ts",
      "import": "./dist/installation/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run test/unit test/qualification test/system/support/postgres-database.test.ts --maxWorkers=1",
    "test:integration": "vitest run test/integration --maxWorkers=1",
    "test:external": "node test/qualification/run-external.ts",
    "test:package": "node test/package/run.ts",
    "test:system": "node test/system/run.ts",
    "test:remote": "node test/system/run.ts remote",
    "test:embedded": "node test/system/run.ts embedded",
    "test:ci": "node test/system/run.ts ci"
  },
  "dependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "pg-connection-string": "2.14.0"
  },
  "devDependencies": {
    "@keynes/database": "workspace:*",
    "@keynes/sdk": "workspace:*",
    "@keynes/testkit": "workspace:*",
    "oxfmt": "0.64.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@keynes/sdk": "0.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
