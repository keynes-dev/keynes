{
  "name": "@keynes/sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "import": "./dist/sdk/src/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-sdk-package.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1 --exclude \"**/*.native.test.ts\" --exclude \"qualification/**\"",
    "test:budget": "vitest run src/budget-lifecycle.test.ts",
    "test:platform": "node src/private/run-platform-tests.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
