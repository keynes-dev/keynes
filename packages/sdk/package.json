{
  "name": "@keynes/sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run test/unit test/conformance --maxWorkers=1",
    "test:unit": "vitest run test/unit --maxWorkers=1",
    "test:conformance": "vitest run test/conformance --maxWorkers=1",
    "test:package:unit": "vitest run test/package --maxWorkers=1",
    "test:package": "pnpm test:package:unit && node test/package/qualify.ts",
    "test:performance": "vitest run test/performance --maxWorkers=1",
    "measure:package": "node test/performance/measure.ts"
  },
  "dependencies": {
    "@pgsql/types": "18.0.0",
    "decimal.js": "10.6.0",
    "kysely": "0.29.5",
    "libpg-query": "18.1.4"
  },
  "devDependencies": {
    "@keynes/contracts": "workspace:*",
    "@keynes/testkit": "workspace:*",
    "json-schema-to-typescript": "15.0.4",
    "oxfmt": "0.64.0",
    "vitest": "4.1.11"
  },
  "bundledDependencies": [
    "@pgsql/types",
    "decimal.js",
    "kysely",
    "libpg-query"
  ],
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  }
}
