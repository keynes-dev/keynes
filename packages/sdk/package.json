{
  "name": "@keynes/sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run test/unit test/contract test/system --maxWorkers=1",
    "test:unit": "vitest run test/unit --maxWorkers=1",
    "test:contract": "vitest run test/contract --maxWorkers=1",
    "test:package:unit": "vitest run test/package --maxWorkers=1",
    "test:package": "pnpm test:package:unit && node test/package/qualify.ts",
    "test:performance": "vitest run test/performance --maxWorkers=1",
    "measure:package": "node test/performance/measure.ts",
    "test:local": "node test/system/run-local.ts",
    "test:hosted": "node test/system/run-hosted.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@keynes/database": "workspace:*",
    "@keynes/testkit": "workspace:*",
    "@types/pg": "8.23.1",
    "json-schema-to-typescript": "15.0.4",
    "oxfmt": "0.64.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
