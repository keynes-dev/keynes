{
  "name": "@keynes/postgresql",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "keynes-postgresql": "dist/cli.js"
  },
  "files": [
    "dist",
    "generated",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./private/run-installation": {
      "types": "./dist/private/run-installation.d.ts",
      "import": "./dist/private/run-installation.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-postgresql-package.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
