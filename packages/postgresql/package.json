{
  "name": "@keynes/postgresql",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "keynes-postgresql": "dist/cli.js"
  },
  "files": [
    "dist",
    "generated",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {},
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "prepack": "pnpm build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run test/unit test/qualification --maxWorkers=1",
    "test:integration": "vitest run test/integration --maxWorkers=1",
    "test:external": "node test/qualification/run-external.ts",
    "test:package": "node test/package/run.ts",
    "test:system": "node test/system/run.ts"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@keynes/contracts": "workspace:*",
    "@keynes/testkit": "workspace:*",
    "@types/pg": "8.15.5",
    "oxfmt": "0.64.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
